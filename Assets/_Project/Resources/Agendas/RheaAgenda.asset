  Threads:
  - ThreadId: milo-parcel-rumour
    DisplayName: A neighbour who notices things
    Summary: Rhea shares an uncertain, second-hand account about Milo after closing.
    Priority: 10
    Stages:
    - StageId: first-conversation
      Title: A neighbour who notices things
      Dialogue: "Rhea: I heard Milo has been carrying parcels after closing. I don't know what they're for, and I wouldn't take it as proof of anything."
      RequireSocializingActivity: 1
      RequiredActivity: 3
      RequiredPlace: Street
      RequiredDiscoveryId:
      RequiredCompletedContractId:
      RequiredContract: {fileID: 0}
      RequiredUpgradeId:
      RequiredUpgrade: {fileID: 0}
      RequireUpgradeNotAcquired: 0
      Choices:
      - ChoiceId: ask-source
        Label: "Ask where she heard it"
        Response: "Rhea: Someone from the block mentioned it. I haven't seen where the parcels go, so that's all I can tell you."
        CompleteStageOnChoice: 1
        Action: 1
        DiscoveryId: rhea-milo-parcel-rumour
        DiscoverySubjectId: milo
        DiscoveryType: 3
        DiscoveryDescription: "Rhea says someone from the block told her Milo has carried parcels after closing. She has not seen where they go."
        DiscoveryConfidence: 0.4
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
      - ChoiceId: ask-why
        Label: "Ask why she is telling you"
        Response: "Rhea: Because people start making up stories when they don't know the whole thing. Better you hear how little I actually know."
        CompleteStageOnChoice: 1
        Action: 1
        DiscoveryId: rhea-milo-parcel-rumour
        DiscoverySubjectId: milo
        DiscoveryType: 3
        DiscoveryDescription: "Rhea says someone from the block told her Milo has carried parcels after closing. She has not seen where they go."
        DiscoveryConfidence: 0.4
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
      - ChoiceId: leave-subject
        Label: "Leave it there"
        Response: "Rhea: Fair enough. I only wanted you to know it was talk, not something I could prove."
        CompleteStageOnChoice: 1
        Action: 1
        DiscoveryId: rhea-milo-parcel-rumour
        DiscoverySubjectId: milo
        DiscoveryType: 3
        DiscoveryDescription: "Rhea says someone from the block told her Milo has carried parcels after closing. She has not seen where they go."
        DiscoveryConfidence: 0.4
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
  - ThreadId: compact-sewing-machine
    DisplayName: Something in the back room
    Summary: Rhea offers an old compact sewing machine after Milo's request is completed.
    Priority: 30
    Stages:
    - StageId: offer-machine
      Title: Something in the back room
      Dialogue: "Rhea: I have an old compact sewing machine in the back. It still runs. If you're serious about making a little workshop out of that place, I could let it go."
      RequireSocializingActivity: 0
      RequiredActivity: 0
      RequiredPlace:
      RequiredDiscoveryId:
      RequiredCompletedContractId:
      RequiredContract: {fileID: 11400000, guid: dd000000000000000000000000000001, type: 2}
      RequiredUpgradeId:
      RequiredUpgrade: {fileID: 11400000, guid: ee000000000000000000000000000001, type: 2}
      RequireUpgradeNotAcquired: 1
      Choices:
      - ChoiceId: see-machine
        Label: "Take a look"
        Response: "Rhea: It's yours to consider. Have a look at the offer."
        CompleteStageOnChoice: 0
        Action: 3
        WorkshopUpgradeOffer: {fileID: 11400000, guid: ee000000000000000000000000000001, type: 2}
        DiscoveryId:
        DiscoverySubjectId:
        DiscoveryType: 1
        DiscoveryDescription:
        DiscoveryConfidence: 1
        FamiliarityDelta: 0
        TrustDelta: 0
        AffinityDelta: 0
      - ChoiceId: maybe-later
