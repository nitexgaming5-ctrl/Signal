  m_Name: Rhea_Agenda
  m_EditorClassIdentifier:
  NpcId: rhea
  Threads:
  - ThreadId: rhea-milo-rumour
    DisplayName: A neighbour who notices things
    Summary: Rhea shares a cautious piece of hearsay about Milo, without claiming to know what it means.
    Priority: 10
    Stages:
    - StageId: first-tip
      Title: A neighbour who notices things
      Dialogue: "Rhea: I heard Milo has been carrying parcels after closing. I don't know why, and I haven't seen it myself. Could be nothing."
      RequireSocializingActivity: 1
      RequiredActivity: 3
      RequiredPlace: Street
      RequiredDiscoveryId:
      RequiredCompletedContractId:
      RequiredContract: {fileID: 0}
      RequiredUpgradeId:
      RequiredUpgrade: {fileID: 0}
      RequireUpgradeNotAcquired: 0
      Choices:
      - ChoiceId: ask-source
        Label: Ask where she heard it
        Response: "Rhea: A neighbour on the late shift mentioned it. I didn't see it myself, so don't take it as fact."
        Action: 1
        CompleteStageOnChoice: 1
        DiscoveryId: rhea-milo-after-hours-rumour
        DiscoverySubjectId: milo
        DiscoveryType: 3
        DiscoveryDescription: Rhea says a neighbour mentioned seeing Milo with parcels after closing. She did not witness it herself and does not know why.
        DiscoveryConfidence: 0.4
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
        WorkshopUpgradeOffer: {fileID: 0}
      - ChoiceId: ask-why
        Label: Ask why she is telling you
        Response: "Rhea: He looked worried, that's all. I thought you ought to know. But it could be nothing."
        Action: 1
        CompleteStageOnChoice: 1
        DiscoveryId: rhea-milo-after-hours-rumour
        DiscoverySubjectId: milo
        DiscoveryType: 3
        DiscoveryDescription: Rhea says a neighbour mentioned seeing Milo with parcels after closing. She did not witness it herself and does not know why.
        DiscoveryConfidence: 0.4
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
        WorkshopUpgradeOffer: {fileID: 0}
      - ChoiceId: leave-it
        Label: Leave the subject
        Response: "Rhea: Fair enough. I wouldn't build a story around it."
        Action: 1
        CompleteStageOnChoice: 1
        DiscoveryId: rhea-milo-after-hours-rumour
        DiscoverySubjectId: milo
        DiscoveryType: 3
        DiscoveryDescription: Rhea says a neighbour mentioned seeing Milo with parcels after closing. She did not witness it herself and does not know why.
        DiscoveryConfidence: 0.4
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
        WorkshopUpgradeOffer: {fileID: 0}
  - ThreadId: rhea-old-sewing-machine
    DisplayName: Something in the back room
    Summary: Rhea offers her old compact sewing machine after Milo's customer request is completed.
    Priority: 20
    Stages:
    - StageId: machine-offer
      Title: Something in the back room
      Dialogue: "Rhea: I've got an old compact sewing machine in the back. It's not pretty, but the motor still runs. I can let it go for 90 CARD once you've finished Milo's request."
      RequireSocializingActivity: 0
      RequiredActivity: 1
      RequiredPlace: CornerShop
      RequiredDiscoveryId:
      RequiredCompletedContractId: first-customer-contract
      RequiredContract: {fileID: 0}
      RequiredUpgradeId: compact-sewing-machine
      RequiredUpgrade: {fileID: 0}
      RequireUpgradeNotAcquired: 1
      Choices:
      - ChoiceId: inspect-offer
        Label: Take a look at the offer
        Response: "Rhea: Sure. Let's see if it's worth your money."
        Action: 3
        CompleteStageOnChoice: 0
        DiscoveryId:
        DiscoverySubjectId:
        DiscoveryType: 1
        DiscoveryDescription:
        DiscoveryConfidence: 1
        FamiliarityDelta: 0
        TrustDelta: 0
        AffinityDelta: 0
        WorkshopUpgradeOffer: {fileID: 11400000, guid: ee000000000000000000000000000001, type: 2}
      - ChoiceId: later
        Label: Maybe later
        Response: "Rhea: No rush. It'll be here if you change your mind."
        Action: 0
        CompleteStageOnChoice: 0
        DiscoveryId:
        DiscoverySubjectId:
        DiscoveryType: 1
        DiscoveryDescription:
        DiscoveryConfidence: 1
        FamiliarityDelta: 0
        TrustDelta: 0
        AffinityDelta: 0
        WorkshopUpgradeOffer: {fileID: 0}
  - ThreadId: rhea-mending-advice
    DisplayName: Perhaps I need a favour myself
    Summary: After the machine is installed, Rhea shares practical advice and hints she may need mending help later.
    Priority: 30
    Stages:
    - StageId: first-mending-advice
      Title: Perhaps I need a favour myself
      Dialogue: "Rhea: That old machine should do. Keep your tension even on thicker seams, and don't pull the cloth through. Let the feed dogs do the work. I used to mend half the block's coats with one of those."
      RequireSocializingActivity: 0
      RequiredActivity: 0
      RequiredPlace:
      RequiredDiscoveryId:
      RequiredCompletedContractId:
      RequiredContract: {fileID: 0}
      RequiredUpgradeId: compact-sewing-machine
      RequiredUpgrade: {fileID: 0}
      RequireUpgradeNotAcquired: 0
      Choices:
      - ChoiceId: thank-rhea
        Label: Thank her for the advice
        Response: "Rhea: You'll get the feel for it. Just don't rush the difficult seams."
        Action: 2
        CompleteStageOnChoice: 1
        DiscoveryId:
        DiscoverySubjectId:
        DiscoveryType: 1
        DiscoveryDescription:
        DiscoveryConfidence: 1
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0
        WorkshopUpgradeOffer: {fileID: 0}
      - ChoiceId: ask-about-mending
        Label: Ask if she would take on mending work again
        Response: "Rhea: Maybe, if I had a proper setup. People still bring me things they don't want to throw away."
        Action: 2
        CompleteStageOnChoice: 1
        DiscoveryId:
        DiscoverySubjectId:
        DiscoveryType: 1
        DiscoveryDescription:
        DiscoveryConfidence: 1
        FamiliarityDelta: 0.05
        TrustDelta: 0
        AffinityDelta: 0.02
        WorkshopUpgradeOffer: {fileID: 0}
